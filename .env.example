# Required
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: subdomain tenancy (e.g. orbitos.io with a *.orbitos.io wildcard on Vercel)
NEXT_PUBLIC_ROOT_DOMAIN=
# Shown on the Security and Privacy pages as the address for vulnerability reports and data requests
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional: shown under Settings > Data Governance (display only)
NEXT_PUBLIC_DATA_REGION="EU (Frankfurt)"

# IntaSend (payments) — no Stripe anywhere in this app
INTASEND_PUBLISHABLE_KEY=
INTASEND_SECRET_KEY=
INTASEND_WEBHOOK_CHALLENGE=
INTASEND_TEST_MODE=true
# Card currencies enabled on your IntaSend account (default: all four). Unlisted workspace currencies are charged in USD.
INTASEND_CARD_CURRENCIES=KES,USD,EUR,GBP

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="OrbitOS <noreply@yourdomain.com>"

# Cron + integrations
CRON_SECRET=
GITHUB_WEBHOOK_SECRET=

# Passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=OrbitOS

# Error alerts (Sentry). Off unless the DSN is set; read at build time, so redeploy after changing.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: readable stack traces (source-map upload during build)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# WhatsApp Cloud API (check-ins by reply, one-tap expense approvals, weekly brief). Off unless all four are set.
# Setup: docs/WHATSAPP.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# AI chief of staff (Claude). Without a key, briefs are a rule-based summary. The owner must also turn it on in the app.
# Setup: docs/AI-CHIEF-OF-STAFF.md
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Encrypts third-party credentials at rest (KRA eTIMS keys, calendar tokens). Required for eTIMS and calendar sync.
# 64 hex characters: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"  — never change it once set.
ENCRYPTION_KEY=

# KRA eTIMS (OSCU) for OrbitOS's own plan receipts. Workspaces connect their own device in Settings. Setup: docs/ETIMS.md
ETIMS_ENV=sandbox
ETIMS_TIN=
ETIMS_BHF_ID=00
ETIMS_DEVICE_SERIAL=
ETIMS_ITEM_CLS_CD=
# Optional: B = 16% VAT (default), A exempt, C zero-rated, D non-VAT, E 8%
ETIMS_TAX_TYPE=B
ETIMS_ITEM_NAME="OrbitOS subscription"

# Google Calendar / Outlook two-way sync (each person connects in Profile). Set either or both. Setup: docs/CALENDAR.md
# Redirect URIs: https://<your-app>/api/calendar/callback/google and .../microsoft
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Optional: your Entra tenant id to allow only your company's accounts (default: common)
MICROSOFT_CALENDAR_TENANT=

# Optional distributed rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
